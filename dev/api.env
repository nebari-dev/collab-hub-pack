# Environment for running the Collab Hub API on the host against the
# dev/docker-compose.yaml stack. Loaded by `make -C dev api`; or source it:
#   set -a; . dev/api.env; set +a; cd api && uv run --python 3.14 python -m collab_hub_api
#
# LOCAL-ONLY VALUES. Every secret below is a throwaway for localhost and is
# matched by dev/keycloak/nebari-realm.json. Nothing here belongs on a
# deployment. The API refuses plain-http issuers/URLs off loopback, so these
# only work with the hostnames as written.

# --- Server ---------------------------------------------------------------
COLLAB_HUB_API__SERVER__PORT=8010
COLLAB_HUB_API__STORAGE__FRAMES_PATH=./dev/.data/frames

# --- Bearer auth (the API axis: desktop / MCP clients) ---------------------
# Realm imported into the Keycloak container. The web surface inherits this
# issuer (COLLAB_HUB_API__WEB__ISSUER_URL is deliberately unset).
FRAMES_BEARER_ISSUER=http://localhost:8080/realms/nebari
FRAMES_BEARER_JWKS_URL=http://localhost:8080/realms/nebari/protocol/openid-connect/certs
FRAMES_BEARER_AUDIENCE=apollo-desktop
# Membership mode: organizations come from collab_org_members, keyed by `sub`.
# This is what makes invitations, the operator page and the owner page exist.
FRAMES_AUTH_IDENTITY_CLAIM=sub
FRAMES_AUTH_ORG_SOURCE=membership

# --- Postgres (history, groups, orgs, invitations, usage, active state) ----
COLLAB_HUB_API__FRAMES__POSTGRES__URL=postgresql://collab:collab@localhost:5432/collab
COLLAB_HUB_API__FRAMES__POSTGRES__AUTO_MIGRATE=true
COLLAB_HUB_API__FRAMES__ACTIVE_STATE__BACKEND=postgres
COLLAB_HUB_API__FRAMES__ACTIVE_STATE__POSTGRES__AUTO_MIGRATE=true

# --- Web surface (the browser axis: /web, /admin, /invite/accept) ----------
COLLAB_HUB_API__WEB__CLIENT_ID=collab-web
COLLAB_HUB_API__WEB__CLIENT_SECRET=collab-web-local-dev-secret
# >= 32 chars with >= 16 distinct characters; identical on every replica.
COLLAB_HUB_API__WEB__SESSION_SECRET=local-dev-session-secret-0123456789-abcdefghijklmnop
COLLAB_HUB_API__WEB__PUBLIC_BASE_URL=http://localhost:8010

# --- Invitation email via SES v2 -> dev/fake-ses -> Mailpit ----------------
COLLAB_HUB_API__FRAMES__EMAIL__PROVIDER=ses
COLLAB_HUB_API__FRAMES__EMAIL__ACCEPT_URL=http://localhost:8010/invite/accept
COLLAB_HUB_API__FRAMES__EMAIL__APP_INSTRUCTIONS="This is a local development stack; there is no desktop build to install. Open the acceptance link in your browser."
COLLAB_HUB_API__FRAMES__EMAIL__SES__SENDER_ADDRESS=invitations@collab-hub.local
COLLAB_HUB_API__FRAMES__EMAIL__SES__REGION=us-east-1
COLLAB_HUB_API__FRAMES__EMAIL__SES__CONFIGURATION_SET=local
# boto3 reads these from the environment; the API itself takes no endpoint
# setting (by design). The fake SES ignores the key pair.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_SESV2=http://localhost:4566
